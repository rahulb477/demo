# Database (SQLite file for local dev; see README for PostgreSQL)
DATABASE_URL="file:./data/orbit.db"

# Session signing secret — REQUIRED in production. Generate: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# Seed passwords (used only by `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@orbitpos.local"
SEED_ADMIN_PASSWORD="Admin#12345"
SEED_CASHIER_EMAIL="cashier@orbitpos.local"
SEED_CASHIER_PASSWORD="Cashier#12345"
